# Copy this file to .env and fill in your credentials.
# .env is ignored by git and must not be committed.
## BookWalker
BOOKWALKER_URL=https://bookwalker.jp/st3/
BOOKWALKER_EMAIL=your-email@example.com
BOOKWALKER_PASSWORD=your-password
# Optional; the default matches scripts/start_bookwalker_chrome.ps1.
BOOKWALKER_CDP_ENDPOINT=http://127.0.0.1:9222

## Manga ONE
MANGAONE_CDP_ENDPOINT=http://127.0.0.1:9222
MANGAONE_URL=https://manga-one.com/login
MANGAONE_EMAIL=your-email@example.com
MANGAONE_PASSWORD=your-password

## Add another site's values with the same site prefix, for example:
# OTHER_SITE_URL=https://example.com/login
# OTHER_SITE_EMAIL=your-email@example.com
# OTHER_SITE_PASSWORD=your-password
# OTHER_SITE_CDP_ENDPOINT=http://127.0.0.1:9222
